<?xml version="1.0" encoding="UTF-8"?>
<persistence
    xmlns="https://jakarta.ee/xml/ns/persistence"
    xmlns:xsi="https://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
      https://jakarta.ee/xml/ns/persistence
      https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
    version="3.2">

  <persistence-unit name="brad">
  	<class>tw.brad.hibernate.entity.Account</class>
  	<class>tw.brad.hibernate.entity.AccountInfo</class>
  	<class>tw.brad.hibernate.entity.Order</class>
  	<class>tw.brad.hibernate.entity.OrderItem</class>
  	<class>tw.brad.hibernate.entity.Student</class>
  	<class>tw.brad.hibernate.entity.Course</class>
    <properties>
      <property name="jakarta.persistence.jdbc.driver"
                value="com.mysql.cj.jdbc.Driver"/>

      <property name="jakarta.persistence.jdbc.url"
                value="jdbc:mysql://localhost:3306/brad"/>

      <property name="jakarta.persistence.jdbc.user"
                value="root"/>

      <property name="jakarta.persistence.jdbc.password"
                value="root"/>

      <property name="hibernate.show_sql"
                value="true"/>

      <property name="hibernate.format_sql"
                value="true"/>
    </properties>

  </persistence-unit>

</persistence>